# Database
DATABASE_URL=postgresql://arcom_user:arcom_pass@localhost:5432/arcom_db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
APP_ENV=development
LOG_LEVEL=INFO

# ── AI: Openclaw Gateway (Sprint 3) ────────────────────────────────────────
# Gateway running on this server. From host: http://localhost:18789/v1
# From inside docker: http://host.docker.internal:18789/v1
AI_ENABLED=true
OPENCLAW_BASE_URL=http://host.docker.internal:18789/v1
OPENCLAW_TOKEN=
OPENCLAW_CHAT_MODEL=openclaw/default
OPENCLAW_EMBEDDING_MODEL=openclaw/default
# Optional backend-model override (sent via x-openclaw-model header)
OPENCLAW_CHAT_BACKEND_MODEL=
OPENCLAW_EMBEDDING_BACKEND_MODEL=
OPENCLAW_LLM_TIMEOUT_S=60
OPENCLAW_EMBEDDING_TIMEOUT_S=30
EMBEDDING_DIM=1536
