# Root .env.example — passed to docker-compose
# Copy to .env and fill in values

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Token expiry (hours, default 8 = one shift)
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS (comma-separated for intranet dev)
CORS_ORIGINS=http://localhost:3000

# App
APP_ENV=development
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── AI: Openclaw Gateway (Sprint 3) ────────────────────────────────────────
# Set AI_ENABLED=false to skip Openclaw and use deterministic fallback only.
AI_ENABLED=true
# From within docker compose, host.docker.internal works on Linux+macOS:
OPENCLAW_BASE_URL=http://host.docker.internal:18789/v1
# Paste the value of `gateway.auth.token` from ~/.openclaw/openclaw.json
OPENCLAW_TOKEN=
OPENCLAW_CHAT_MODEL=openclaw/default
OPENCLAW_EMBEDDING_MODEL=openclaw/default
OPENCLAW_LLM_TIMEOUT_S=60
OPENCLAW_EMBEDDING_TIMEOUT_S=30
